# Production build. Replace with your deployed API origin once the backend is
# live on Vercel, e.g. https://streetcanvas-api.vercel.app/api
#
# These are public values baked into the JS bundle - never put a secret in a
# REACT_APP_* variable.
REACT_APP_API_URL=https://streetcanvas-api.vercel.app/api
REACT_APP_ASSET_URL=https://streetcanvas-api.vercel.app
