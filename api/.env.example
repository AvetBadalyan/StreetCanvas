# ---- Database ----------------------------------------------------------
# Full connection string for MongoDB Atlas (or a local mongod).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wanderarmenia?retryWrites=true&w=majority

# ---- Auth --------------------------------------------------------------
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_KEY=replace_me_with_a_long_random_string

# ---- Image hosting (Cloudinary) ----------------------------------------
# Optional locally: with these unset the API falls back to local disk storage.
# REQUIRED in production - Render's filesystem is ephemeral, so disk uploads
# are deleted on every restart/redeploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Server ------------------------------------------------------------
PORT=5000
# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:3000
# Contact address sent to Nominatim as required by its usage policy.
GEOCODER_USER_AGENT=WanderArmenia/1.0 (your-email@example.com)
